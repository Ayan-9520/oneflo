# Copy to .env.production on the VPS. chmod 600. Never commit the copy.
# Docker Compose reads this file inside the containers. It is not published.

APP_KEY=
DB_DATABASE=oneflo
DB_USERNAME=oneflo
DB_PASSWORD=
DB_ROOT_PASSWORD=
MYSQL_DATABASE=oneflo
MYSQL_USER=oneflo
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=

# First boot only. Set to true once, start the stack, then set it back to false.
SEED_INITIAL=false
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=OneFlo Super Admin

SANCTUM_STATEFUL_DOMAINS=app.oneflo.in,api.oneflo.in
ONEFLO_PLATFORM_HOSTS=oneflo.in,www.oneflo.in,app.oneflo.in,api.oneflo.in,localhost,127.0.0.1

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@oneflo.in
MAIL_FROM_NAME=OneFlo
