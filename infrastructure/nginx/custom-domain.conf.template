# Copy to infrastructure/nginx/custom/hr.example.com.conf after the certificate exists.
# Replace hr.example.com. Do not add a domain here until DNS points at this server.
# The application still ignores the host until the domain is verified in OneFlo.

server {
    listen 80;
    server_name hr.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name hr.example.com;
    ssl_certificate /etc/letsencrypt/live/hr.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hr.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    include /etc/nginx/snippets/oneflo-app.conf;
}
